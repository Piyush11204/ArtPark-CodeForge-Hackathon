{
  "name": "artpark-adaptive-onboarding-backend",
  "version": "1.0.0",
  "description": "AI-Adaptive Onboarding Engine — Express + MongoDB backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:jobs": "ts-node src/scripts/seedJobs.ts",
    "seed:courses": "ts-node src/scripts/seedCourses.ts",
    "seed:all": "ts-node src/scripts/seedJobs.ts && ts-node src/scripts/seedCourses.ts"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "html-entities": "^2.5.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "striptags": "^3.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.2",
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
