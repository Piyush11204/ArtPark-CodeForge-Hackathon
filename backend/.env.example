# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Services (Render) ───────────────────────────────────────────────────────
# External resume parser API (already hosted)
RESUME_PARSER_URL=https://app.credxhire.com/api/resume/parse
# URL of the Python ML microservice deployed on Render
ML_SERVICE_URL=https://<your-ml-service>.onrender.com

# URL of this backend on Render (frontend is served by the backend — same origin)
FRONTEND_URL=https://<your-backend-service>.onrender.com

# ─── Upload ───────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
